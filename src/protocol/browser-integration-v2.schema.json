{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abdownloadmanager.com/schemas/browser-integration-v2.schema.json",
  "title": "AB Download Manager Browser Integration Protocol v2",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/capabilities" },
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/captureProposal" },
    { "$ref": "#/$defs/preparedCapture" },
    { "$ref": "#/$defs/browserBatch" },
    { "$ref": "#/$defs/mediaGroup" },
    { "$ref": "#/$defs/ftpCredentials" }
  ],
  "$defs": {
    "protocolVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 2 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secureBridge", "twoPhaseCapture", "ftpCapture", "permissionPolicy", "reviewedBatches", "advancedMediaDiscovery", "adaptiveMediaTransfer", "uxPolicy"],
      "properties": {
        "secureBridge": { "type": "boolean" },
        "twoPhaseCapture": { "type": "boolean" },
        "ftpCapture": { "type": "boolean" },
        "permissionPolicy": { "type": "boolean" },
        "reviewedBatches": { "type": "boolean" },
        "advancedMediaDiscovery": { "type": "boolean" },
        "adaptiveMediaTransfer": { "type": "boolean" },
        "uxPolicy": { "type": "boolean" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "messageId", "kind", "action", "payload"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "messageId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["REQUEST", "RESPONSE", "EVENT"] },
        "action": { "enum": ["HELLO", "GET_POLICY", "POLICY_CHANGED", "PREPARE_CAPTURE", "COMMIT_CAPTURE", "ABORT_CAPTURE", "LIST_PREPARED_CAPTURES", "SUBMIT_BATCH", "CANCEL_BATCH", "QUERY_BROWSER_CONTEXT", "ADDRESS_REFRESH_CAPABILITIES", "ADDRESS_REFRESH_SESSIONS", "ADDRESS_REFRESH_CANDIDATE", "PING", "DIAGNOSTICS"] },
        "deadlineEpochMs": { "type": ["integer", "null"], "minimum": 0 },
        "idempotencyKey": { "type": ["string", "null"], "maxLength": 128 },
        "payload": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "desktopVersion", "supportedActions", "supportedTransports", "supportedSchemes", "maxFrameBytes", "maxBodyBytes", "featureFlags"],
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "desktopVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "supportedActions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "supportedTransports": { "type": "array", "uniqueItems": true, "items": { "enum": ["NATIVE_PORT", "NATIVE_ONE_SHOT", "AUTHENTICATED_HTTP"] } },
        "supportedSchemes": { "type": "array", "uniqueItems": true, "items": { "enum": ["HTTP", "HTTPS", "FTP", "FTPS_EXPLICIT", "FTPS_IMPLICIT", "HLS", "DASH"] } },
        "maxFrameBytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "maxBodyBytes": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "featureFlags": { "$ref": "#/$defs/featureFlags" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revision", "mode", "automaticInterception", "advancedMediaInspection", "privateBrowsing", "sendProtectedContext", "registeredFileTypes", "registeredMimeTypes", "excludedUrls"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "revision": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["OFF", "STANDARD", "FULL"] },
        "automaticInterception": { "type": "boolean" },
        "advancedMediaInspection": { "type": "boolean" },
        "privateBrowsing": { "type": "boolean" },
        "sendProtectedContext": { "type": "boolean" },
        "registeredFileTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9]{1,16}$" } },
        "registeredMimeTypes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
        "excludedUrls": { "type": "array", "maxItems": 2048, "items": { "type": "string", "maxLength": 16384 } },
        "forceShortcut": { "type": ["string", "null"], "maxLength": 128 },
        "bypassShortcut": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "orderedHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "value": { "type": "string", "maxLength": 65536 }
      }
    },
    "cookie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "domain", "path", "secure", "httpOnly", "session"],
      "properties": {
        "name": { "type": "string", "maxLength": 4096 },
        "value": { "type": "string", "maxLength": 65536 },
        "domain": { "type": "string", "maxLength": 4096 },
        "path": { "type": "string", "maxLength": 4096 },
        "secure": { "type": "boolean" },
        "httpOnly": { "type": "boolean" },
        "sameSite": { "type": ["string", "null"], "enum": ["NO_RESTRICTION", "LAX", "STRICT", "UNSPECIFIED", null] },
        "expirationEpochSeconds": { "type": ["number", "null"], "minimum": 0 },
        "storeId": { "type": ["string", "null"], "maxLength": 256 },
        "partitionKey": { "type": ["string", "null"], "maxLength": 4096 },
        "session": { "type": "boolean" }
      }
    },
    "requestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data", "sha256", "byteLength"],
      "properties": {
        "mediaType": { "type": ["string", "null"], "maxLength": 256 },
        "encoding": { "const": "BASE64" },
        "data": { "type": "string", "maxLength": 5592408 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 4194304 }
      }
    },
    "redirectHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromUrl", "toUrl", "statusCode", "responseHeaders"],
      "properties": {
        "fromUrl": { "type": "string", "maxLength": 16384 },
        "toUrl": { "type": "string", "maxLength": 16384 },
        "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
        "responseHeaders": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/orderedHeader" } }
      }
    },
    "proxyContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["DIRECT", "HTTP", "HTTPS", "SOCKS4", "SOCKS5", "SYSTEM", "UNKNOWN"] },
        "endpoint": { "type": ["string", "null"], "maxLength": 4096 },
        "usernameRef": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "requestContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalUrl", "finalUrl", "method", "requestHeaders", "responseHeaders", "cookies", "redirects", "tabId", "frameId", "privateContext", "withheldFields", "incompleteFields"],
      "properties": {
        "originalUrl": { "type": "string", "maxLength": 16384 },
        "finalUrl": { "type": "string", "maxLength": 16384 },
        "method": { "type": "string", "pattern": "^[A-Z]{1,16}$" },
        "requestBody": { "anyOf": [{ "$ref": "#/$defs/requestBody" }, { "type": "null" }] },
        "requestHeaders": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/orderedHeader" } },
        "responseHeaders": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/orderedHeader" } },
        "cookies": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/cookie" } },
        "redirects": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/redirectHop" } },
        "referrer": { "type": ["string", "null"], "maxLength": 16384 },
        "origin": { "type": ["string", "null"], "maxLength": 16384 },
        "initiator": { "type": ["string", "null"], "maxLength": 16384 },
        "documentUrl": { "type": ["string", "null"], "maxLength": 16384 },
        "tabId": { "type": "integer" },
        "frameId": { "type": "integer" },
        "parentFrameId": { "type": ["integer", "null"] },
        "privateContext": { "type": "boolean" },
        "containerId": { "type": ["string", "null"], "maxLength": 256 },
        "fileName": { "type": ["string", "null"], "maxLength": 4096 },
        "mimeType": { "type": ["string", "null"], "maxLength": 256 },
        "expectedSize": { "type": ["integer", "null"], "minimum": 0 },
        "statusCode": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "remoteAddress": { "type": ["string", "null"], "maxLength": 4096 },
        "proxy": { "anyOf": [{ "$ref": "#/$defs/proxyContext" }, { "type": "null" }] },
        "withheldFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } },
        "incompleteFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 128 } }
      }
    },
    "captureProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureId", "idempotencyKey", "browserFamily", "generation", "requestContext", "requestedDisposition"],
      "properties": {
        "captureId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "browserFamily": { "enum": ["CHROME", "EDGE", "FIREFOX", "OPERA", "CHROMIUM", "BRAVE", "VIVALDI", "UNKNOWN"] },
        "browserDownloadId": { "type": ["integer", "null"] },
        "generation": { "type": "integer", "minimum": 0 },
        "requestContext": { "$ref": "#/$defs/requestContext" },
        "requestedDisposition": { "enum": ["TASK", "REVIEW"] }
      }
    },
    "preparedCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureId", "contextRef", "state", "expiresAtEpochMs"],
      "properties": {
        "captureId": { "type": "string", "maxLength": 128 },
        "contextRef": { "type": "string", "maxLength": 256 },
        "state": { "enum": ["PREPARED", "BROWSER_RELEASED", "COMMITTED_TASK", "COMMITTED_REVIEW", "ABORTED", "RECOVERY_REQUIRED"] },
        "expiresAtEpochMs": { "type": "integer", "minimum": 0 }
      }
    },
    "browserCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "url", "sourceKind", "frameId"],
      "properties": {
        "candidateId": { "type": "string", "maxLength": 128 },
        "url": { "type": "string", "maxLength": 16384 },
        "sourceKind": { "enum": ["LINK", "IMAGE", "AUDIO", "VIDEO", "TEXT", "INPUT", "SCRIPT", "FRAME", "MEDIA"] },
        "frameId": { "type": "integer" },
        "description": { "type": ["string", "null"], "maxLength": 4096 },
        "suggestedName": { "type": ["string", "null"], "maxLength": 4096 },
        "contextRef": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "browserBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "generation", "chunkIndex", "chunkCount", "candidates"],
      "properties": {
        "operationId": { "type": "string", "maxLength": 128 },
        "generation": { "type": "integer", "minimum": 0 },
        "chunkIndex": { "type": "integer", "minimum": 0 },
        "chunkCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "candidates": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/browserCandidate" } }
      }
    },
    "mediaTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "role", "selected"],
      "properties": {
        "trackId": { "type": "string", "maxLength": 256 },
        "role": { "enum": ["VIDEO", "AUDIO", "SUBTITLE"] },
        "language": { "type": ["string", "null"], "maxLength": 64 },
        "codec": { "type": ["string", "null"], "maxLength": 256 },
        "selected": { "type": "boolean" }
      }
    },
    "mediaVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "url", "transport", "tracks"],
      "properties": {
        "variantId": { "type": "string", "maxLength": 256 },
        "url": { "type": "string", "maxLength": 16384 },
        "transport": { "enum": ["PROGRESSIVE", "HLS", "DASH"] },
        "width": { "type": ["integer", "null"], "minimum": 0 },
        "height": { "type": ["integer", "null"], "minimum": 0 },
        "frameRate": { "type": ["number", "null"], "minimum": 0 },
        "bandwidth": { "type": ["integer", "null"], "minimum": 0 },
        "container": { "type": ["string", "null"], "maxLength": 64 },
        "tracks": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/mediaTrack" } },
        "contextRef": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "mediaGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "pageGeneration", "title", "live", "protectedMedia", "variants"],
      "properties": {
        "groupId": { "type": "string", "maxLength": 256 },
        "pageGeneration": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "maxLength": 4096 },
        "live": { "type": "boolean" },
        "protectedMedia": { "type": "boolean" },
        "variants": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/mediaVariant" } }
      }
    },
    "ftpCredentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "host", "port", "path", "passive", "binary"],
      "properties": {
        "mode": { "enum": ["FTP", "FTPS_EXPLICIT", "FTPS_IMPLICIT"] },
        "host": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "credentialRef": { "type": ["string", "null"], "maxLength": 256 },
        "passive": { "type": "boolean" },
        "binary": { "const": true },
        "proxyRef": { "type": ["string", "null"], "maxLength": 256 }
      }
    }
  }
}
